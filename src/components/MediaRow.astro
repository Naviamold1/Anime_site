---
import type { Media } from "@/db/schema";
import MediaCard from "./MediaCard.astro";

interface Props {
  title: string;
  items: Media[];
}

const { title, items } = Astro.props;
---

<section class="py-6 sm:py-8 w-full">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-xl sm:text-2xl font-bold text-white mb-4 tracking-tight">
      {title}
    </h2>
    
    {/* Horizontal Scroll Container */}
    <div class="relative group">
      <div class="flex overflow-x-auto gap-4 pb-6 pt-2 snap-x snap-mandatory hide-scrollbar">
        {items.map((item) => (
          <div class="snap-start shrink-0 w-[150px] sm:w-[180px] md:w-[200px] lg:w-[220px]">
            <MediaCard media={item} />
          </div>
        ))}
      </div>
      
      {/* Optional: Add gradient fades on the edges to hint at scrollability */}
      <div class="pointer-events-none absolute top-0 right-0 h-full w-12 bg-gradient-to-l from-[#090909] to-transparent"></div>
    </div>
  </div>
</section>

<style>
  /* Custom scrollbar hiding */
  .hide-scrollbar {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
  .hide-scrollbar::-webkit-scrollbar {
    display: none; /* Chrome, Safari and Opera */
  }
</style>
