---
import Layout from "@/layouts/Layout.astro";
import SettingsForm from "@/components/SettingsForm";
import { auth } from "@/lib/auth";

export const prerender = false;

const session = await auth.api.getSession({ headers: Astro.request.headers });

if (!session) {
  return Astro.redirect("/");
}
---

<Layout title="Account Settings | AnimeLibrary">
  <main class="container mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20 flex justify-center">
    <div class="w-full max-w-xl">
      <header class="mb-10 text-center">
        <h1 class="text-3xl font-black text-white mb-3">Account Settings</h1>
        <p class="text-zinc-500 text-sm">Update your public profile and account details.</p>
      </header>

      <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 sm:p-10 shadow-xl">
        <SettingsForm client:load user={session.user} />
      </div>

      <div class="mt-8 pt-8 border-t border-zinc-800/50 text-center">
        <a href="/" class="text-sm font-bold text-zinc-500 hover:text-orange-500 transition-colors">
          &larr; Back to Dashboard
        </a>
      </div>
    </div>
  </main>
</Layout>
