---
import Layout from "@/layouts/Layout.astro";
import MediaCard from "@/components/MediaCard.astro";
import { searchMedia } from "@/db/queries";

export const prerender = false; // Enable SSR for URL query parameters

const query = Astro.url.searchParams.get("q") || "";
const results = query ? await searchMedia({ query, limit: 48 }) : [];

---

<Layout title={query ? `Search: ${query} | Anime & Manga Library` : "Search Anime | Anime & Manga Library"}>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12 min-h-[calc(100vh-64px)]">
    
    <header class="mb-8 md:mb-12">
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white mb-2">
        {query ? `Search Results for "${query}"` : "Search for Anime"}
      </h1>
      <p class="text-zinc-400">
        {query ? `Found ${results.length} results.` : "Enter a search term in the navigation bar to find anime titles, genres, and more."}
      </p>
    </header>

    {query && results.length > 0 ? (
      <div class="grid grid-cols-2 xs:grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-8 gap-4 sm:gap-6">
        {results.map((anime) => (
          <MediaCard media={anime} />
        ))}
      </div>
    ) : query && results.length === 0 ? (
      <div class="py-20 text-center">
        <h2 class="text-2xl font-bold text-zinc-300 mb-2">No results found</h2>
        <p class="text-zinc-500">We couldn't find anything matching "{query}". Try different keywords or less specific terms.</p>
      </div>
    ) : null}
    
  </div>
</Layout>
